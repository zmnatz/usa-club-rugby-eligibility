{
  "name": "@zmnatz/usa-club-rugby-components",
  "version": "0.9.0",
  "description": "Plain HTML and CSS React components for USA Club Rugby NCS eligibility: the club directory, eligibility report and player detail, for any app using @zmnatz/usa-club-rugby-data.",
  "keywords": [
    "rugby",
    "usa-club-rugby",
    "rugby-xplorer",
    "eligibility",
    "ncs",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmnatz/usa-club-rugby-eligibility.git",
    "directory": "packages/usa-club-rugby-components"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "prepublishOnly": "rm -rf dist && bun run build"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "@zmnatz/usa-club-rugby-data": "^0.6.0"
  },
  "devDependencies": {
    "react": "^19.2.8",
    "@zmnatz/usa-club-rugby-data": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
